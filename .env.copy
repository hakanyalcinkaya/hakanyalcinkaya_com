# Örnek ortam dosyası. Kopyalayıp .env adıyla kaydedin, değerleri doldurun: cp .env.copy .env
# Ayarlar: config/settings/ (DEBUG=True -> settings_dev.py, False -> settings_prod.py)

# --- Django ---
DEBUG=False
# Uzun ve rastgele: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Prod: asıl alan adı; www buraya yönlendirilir. SITE_URL e-postalardaki bağlantılar içindir.
CANONICAL_HOST=hakanyalcinkaya.com
SITE_URL=https://hakanyalcinkaya.com
# HSTS önce 1 saat; sorunsuz çalışınca 31536000 (1 yıl).
SECURE_HSTS_SECONDS=3600

# --- PostgreSQL ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Celery (Redis) ---
# Sunucudaki diğer projelerle karışmaması için ayrı veritabanı numarası.
CELERY_BROKER_URL=redis://localhost:6379/2

# --- Bunny Stream (varsayılan video platformu) ---
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
# CDN token koruması: Bunny panelinde açılınca True yapılır (ikisi birlikte).
BUNNY_TOKEN_KEY=
BUNNY_CDN_TOKEN_AUTH=False

# --- Vimeo (stüdyo ayarlarından seçilebilen ikinci platform) ---
VIMEO_ACCESS_TOKEN=
VIMEO_EMBED_DOMAINS=hakanyalcinkaya.dev,hakanyalcinkaya.com

# --- E-posta (SendGrid SMTP; anahtar yoksa e-postalar terminale yazılır) ---
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=Hakan Yalçınkaya <no-reply@hakanyalcinkaya.com>
# Tanımlıysa bütün e-postalar yalnız bu adrese gider (test). Yayında boş bırakın.
EMAIL_REDIRECT_TO=
# Stüdyodaki "Test gönder" düğmelerinin adresi; boşsa EMAIL_REDIRECT_TO.
EMAIL_TEST_TO=
# E-posta açılma/tıklama takibinin adresi; boşsa SITE_URL.
EMAIL_TRACKING_URL=
